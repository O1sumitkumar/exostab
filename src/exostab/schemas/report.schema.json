        "n",
        "stable",
        "marginal",
        "unstable",
        "inconclusive"
      ],
      "title": "DrawStats",
      "type": "object"
    },
    "IndicatorResult": {
      "additionalProperties": false,
      "description": "Outcome of one indicator for one system.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "nominal_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "draws": {
          "anyOf": [
            {
              "$ref": "#/$defs/DrawStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
