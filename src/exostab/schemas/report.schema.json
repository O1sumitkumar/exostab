      "type": "object"
    },
    "Star": {
      "additionalProperties": false,
      "description": "The host star. Companion stars are not modelled (see ``n_stars``).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mass_msun": {
          "$ref": "#/$defs/Value"
        },
        "n_stars": {
          "default": 1,
          "title": "N Stars",
          "type": "integer"
        },
        "circumbinary": {
          "default": false,
          "title": "Circumbinary",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "mass_msun"
      ],
      "title": "Star",
      "type": "object"
    },
    "System": {
      "additionalProperties": false,
      "description": "A star with two or more planets, ordered by orbital period.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "star": {
          "$ref": "#/$defs/Star"
        },
        "planets": {
          "items": {
            "$ref": "#/$defs/Planet"
          },
          "title": "Planets",
          "type": "array"
        },
        "epoch_jd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch Jd"
        },
        "source": {
          "$ref": "#/$defs/DataSource"
        },
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CompletionFlag"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "name",
        "star",
        "planets",
        "source"
      ],
      "title": "System",
      "type": "object"
    },
    "Value": {
      "additionalProperties": false,
      "description": "A number with asymmetric uncertainties and its provenance.\n\n``err_plus`` and ``err_minus`` are magnitudes (both >= 0). For an ``upper_limit`` value, ``value``\nis the limit itself.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "err_plus": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Err Plus"
        },
        "err_minus": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Err Minus"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": "measured"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "reference_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Url"
        }
      },
      "title": "Value",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "stable",
        "marginal",
        "unstable",
        "inconclusive"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Everything needed to trace and reproduce one ``exostab check``.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "created_utc": {
      "title": "Created Utc",
      "type": "string"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Command"
    },
    "system": {
      "$ref": "#/$defs/System"
    },
    "data": {
      "$ref": "#/$defs/DataRecord"
    },
    "settings": {
      "$ref": "#/$defs/SettingsRecord"
    },
    "software": {
      "$ref": "#/$defs/SoftwareRecord"
    },
    "nominal": {
      "$ref": "#/$defs/NominalRecord"
    },
    "indicators": {
      "additionalProperties": {
        "$ref": "#/$defs/IndicatorResult"
      },
      "title": "Indicators",
      "type": "object"
    },
    "overall": {
      "$ref": "#/$defs/Overall"
    },
    "runtime_s": {
      "title": "Runtime S",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "created_utc",
    "command",
    "system",
    "data",
    "settings",
    "software",
    "nominal",
    "indicators",
    "overall",
    "runtime_s"
  ],
  "title": "exostab report (schema 1.1)",
  "type": "object",
  "$id": "https://github.com/mimitoz62/exostab/schemas/report-1.1.json"
}
