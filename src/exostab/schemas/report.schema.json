    "Phase": {
      "additionalProperties": false,
      "description": "Orbital phase information for one planet.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PhaseKind",
          "default": "random"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Phase",
      "type": "object"
    },
    "PhaseKind": {
      "description": "How the orbital phase of a planet at the common epoch is known.",
      "enum": [
        "transit",
        "periastron",
        "mean_anomaly",
        "mean_longitude",
        "random"
      ],
      "title": "PhaseKind",
      "type": "string"
    },
    "Planet": {
      "additionalProperties": false,
      "description": "One planet. Orbital elements are in the (assumed coplanar) orbital plane of the system.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "period_days": {
          "$ref": "#/$defs/Value"
        },
        "mass_earth": {
          "$ref": "#/$defs/Value"
        },
        "mass_kind": {
          "$ref": "#/$defs/MassKind",
          "default": "true"
        },
        "eccentricity": {
          "$ref": "#/$defs/Value",
          "default": {
            "value": 0.0,
            "err_plus": null,
            "err_minus": null,
            "provenance": "assumed",
            "reference": null,
            "reference_url": null
          }
        },
        "omega_deg": {
          "$ref": "#/$defs/Value",
          "default": {
            "value": null,
            "err_plus": null,
            "err_minus": null,
            "provenance": "randomized",
            "reference": null,
            "reference_url": null
          }
        },
        "phase": {
          "$ref": "#/$defs/Phase",
          "default": {
            "kind": "random",
            "value": null
          }
        },
        "radius_earth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inclination_deg": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "semimajor_axis_au": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "archive_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Name"
        }
      },
      "required": [
        "name",
        "period_days",
        "mass_earth"
      ],
      "title": "Planet",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a value came from.",
      "enum": [
        "measured",
        "derived",
        "assumed",
        "estimated",
        "randomized",
        "upper_limit"
      ],
      "title": "Provenance",
      "type": "string"
    },
