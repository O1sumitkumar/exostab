        "details": {
          "additionalProperties": true,
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "name",
        "title",
        "verdict",
        "summary",
        "nominal_verdict"
      ],
      "title": "IndicatorResult",
      "type": "object"
    },
    "MassKind": {
      "description": "What a planet mass means.",
      "enum": [
        "true",
        "minimum",
        "estimated"
      ],
      "title": "MassKind",
      "type": "string"
    },
    "NominalRecord": {
      "additionalProperties": false,
      "properties": {
