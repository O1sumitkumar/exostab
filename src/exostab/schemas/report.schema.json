    "DrawStats": {
      "additionalProperties": false,
      "description": "How the Monte Carlo draws were classified by one indicator.",
      "properties": {
        "n": {
          "title": "N",
          "type": "integer"
        },
        "stable": {
          "title": "Stable",
          "type": "integer"
        },
        "marginal": {
          "title": "Marginal",
          "type": "integer"
        },
        "unstable": {
          "title": "Unstable",
