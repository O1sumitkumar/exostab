          "type": "string"
        },
        "numpy": {
          "title": "Numpy",
          "type": "string"
        },
        "astropy": {
          "title": "Astropy",
          "type": "string"
        },
        "pydantic": {
          "title": "Pydantic",
          "type": "string"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
