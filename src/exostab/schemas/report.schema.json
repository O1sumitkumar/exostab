          "type": "number"
        },
        "escape_factor": {
          "title": "Escape Factor",
          "type": "number"
        },
        "encounter_rule": {
          "title": "Encounter Rule",
          "type": "string"
        },
        "budget_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
